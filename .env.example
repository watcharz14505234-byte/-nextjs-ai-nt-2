# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Local MariaDB used by the seed script and the product page.
DATABASE_URL=mysql://root:ChangeMe123!@host.docker.internal:3306/ecommerce

# Secret used by Better Auth to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Base URL of your app
BETTER_AUTH_URL=http://localhost:3000

# Resend API key for the Contact Us form (https://resend.com/api-keys)
RESEND_API_KEY=
# Verified sender address on Resend, e.g. onbording@resend.dev
CONTACT_FROM_EMAIL=
# Recipient inbox that receives contact form submissions
CONTACT_TO_EMAIL=